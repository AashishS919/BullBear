# BullBear backend configuration. Copy to .env and adjust for your environment.

# JWT signing secret - CHANGE THIS in any real deployment.
BB_JWT_SECRET=dev-secret-change-me-please-0123456789abcdef
BB_JWT_ALGORITHM=HS256
BB_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Comma-separated list of allowed CORS origins (the Vite dev server).
BB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seeded admin account (used by the in-memory store on startup).
BB_SEED_ADMIN_EMAIL=aashish@gmail.com
BB_SEED_ADMIN_PASSWORD=Admin@123

# Data backend selector: "memory" (Phase 2 default) or "mongo" (Phase 3).
BB_DATA_BACKEND=memory

# MongoDB (Phase 3). Used only when BB_DATA_BACKEND=mongo.
BB_MONGO_URI=mongodb://localhost:27017
BB_MONGO_DB=bullbear

# Market data source: "mock" (deterministic generator) or "nepsealpha" (real NEPSE
# data via the parse.bot NepseAlpha API). "nepsealpha" requires BB_PARSEBOT_API_KEY
# and BB_DATA_BACKEND=mongo (candles are read from market_candles).
BB_MARKET_SOURCE=mock

# parse.bot NepseAlpha API. Get a key at https://parse.bot (free tier: 100 credits/mo,
# 5 req/min). The scraper id below is the public NepseAlpha marketplace scraper.
BB_PARSEBOT_API_KEY=
BB_PARSEBOT_SCRAPER_ID=646d18ff-34ab-4123-becc-9b1b6b35031e
BB_PARSEBOT_BASE_URL=https://api.parse.bot
# WebSocket/live refresh cadence (seconds). One poll = 1 credit for the whole board.
# Keep high on the free tier; lower after upgrading for a faster live feed.
BB_LIVE_POLL_SECONDS=900

# LSTM predictions JSON fallback (written by ml/infer.py).
BB_PREDICTIONS_PATH=../ml/artifacts/predictions.json
